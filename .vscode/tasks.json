    {
      "label": "📊 Coverage",
      "type": "shell",
      "command": "bun",
      "args": ["run", "test:coverage"],
      "problemMatcher": []
    },
    {
      "label": "👁️ Preview",
      "type": "shell",
      "command": "bun",
      "args": ["run", "preview"],
      "problemMatcher": []
    },
    {
      "label": "🗑️ Clean",
      "type": "shell",
      "command": "bun",
      "args": ["run", "clean"],
      "problemMatcher": []

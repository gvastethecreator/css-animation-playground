        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "✅ Check",
      "type": "shell",
      "command": "bun",
      "args": ["run", "check"],
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "🧠 Typecheck",
      "type": "shell",
      "command": "bun",
      "args": ["run", "typecheck"],
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "🧹 Lint",
      "type": "shell",
      "command": "bun",
      "args": ["run", "lint"],
      "problemMatcher": []
    },
    {
      "label": "✨ Format",
      "type": "shell",
      "command": "bun",
      "args": ["run", "format"],
      "problemMatcher": []
    },
    {
      "label": "🧪 Test",
      "type": "shell",
      "command": "bun",
      "args": ["run", "test"],
      "problemMatcher": []
    },
    {
      "label": "👀 Test Watch",
      "type": "shell",

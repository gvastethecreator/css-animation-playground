# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
*.tsbuildinfo

# Local logs (script outputs)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime
*.local
.env
.env.*
!.env.example

# Lock files from other package managers (we use bun)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Bun lock is tracked
# bun.lock

# IDE
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Tracked IDE files (project-wide tasks and shared settings)
.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json

# OS files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Test coverage
coverage/
*.lcov

# Tooling caches
.cache/
.vite/
.vite-plus/
.vp/

# Local reports (never commit audit/output reports)
*-readiness-report.md
readiness-report.md

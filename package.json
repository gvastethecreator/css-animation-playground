{
  "name": "css-animation-playground",
  "version": "0.2.0",
  "private": true,
  "description": "Interactive playground to design, preview and export CSS and Three.js 3D animations with a visual editor and timeline.",
  "keywords": [
    "animation",
    "bun",
    "css-3d",
    "gsap",
    "keyframes",
    "playground",
    "react",
    "three-js",
    "timeline",
    "vite"
  ],
  "homepage": "https://github.com/gvastethecreator/css-animation-playground#readme",
  "bugs": {
    "url": "https://github.com/gvastethecreator/css-animation-playground/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gvastethecreator/css-animation-playground.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "bun run ./scripts/run-with-log.mjs build \"vp build\"",
    "preview": "vp preview",
    "check": "bun run ./scripts/run-with-log.mjs check \"bun run ./scripts/run-vp-check.mjs\"",
    "typecheck": "bun run ./scripts/run-with-log.mjs typecheck \"tsc --noEmit\"",
    "lint": "bun run ./scripts/run-with-log.mjs lint \"oxlint --deny-warnings\"",
    "lint:fix": "bun run ./scripts/run-with-log.mjs lint-fix \"oxlint --fix\"",
    "format": "bun run ./scripts/run-with-log.mjs format \"oxfmt --write .\"",
    "format:check": "bun run ./scripts/run-with-log.mjs format-check \"oxfmt --check .\"",
    "test": "bun run ./scripts/run-with-log.mjs test \"vp test\"",
    "test:watch": "vp test watch",
    "test:coverage": "bun run ./scripts/run-with-log.mjs coverage \"vp test run --coverage\"",
    "clean": "bun run ./scripts/run-with-log.mjs clean \"bun -e \\\"import { existsSync, rmSync } from 'node:fs'; for (const dir of ['dist', 'coverage', 'logs']) { if (existsSync(dir)) rmSync(dir, { recursive: true, force: true }); }\\\"\""
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "29.0.2",
    "oxfmt": "0.45.0",
    "oxlint": "1.60.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "8.0.8",
    "vite-plus": "^0.1.23",
    "vitest": "4.1.4"
  },
  "engines": {
    "bun": ">=1.3.11",
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.11"
}

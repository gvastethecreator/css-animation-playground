{
  "name": "css-animation-playground",
  "version": "0.2.0",
  "private": true,
  "description": "Interactive playground to design, preview and export CSS and Three.js 3D animations with a visual editor and timeline.",
  "keywords": [
    "animation",
    "css-3d",
    "gsap",
    "keyframes",
    "playground",
    "react",
    "three-js",
    "timeline",
    "vite"
  ],
  "homepage": "https://github.com/gvastethecreator/css-animation-playground#readme",
  "bugs": {
    "url": "https://github.com/gvastethecreator/css-animation-playground/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gvastethecreator/css-animation-playground.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "node ./scripts/run-with-log.mjs build vp build",
    "preview": "vp preview",
    "check": "node ./scripts/run-with-log.mjs check vp check",
    "typecheck": "node ./scripts/run-with-log.mjs typecheck tsc --noEmit",
    "lint": "node ./scripts/run-with-log.mjs lint vp lint --deny-warnings",
    "lint:fix": "node ./scripts/run-with-log.mjs lint-fix vp lint --fix",
    "format": "node ./scripts/run-with-log.mjs format vp fmt . --write",
    "format:check": "node ./scripts/run-with-log.mjs format-check vp fmt . --check",
    "test": "node ./scripts/run-with-log.mjs test vp test",
    "test:watch": "vp test watch",
    "test:coverage": "node ./scripts/run-with-log.mjs coverage vp test run --coverage",
    "clean": "node ./scripts/clean-generated.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.0.0"
}
